# Port configuration on GPU server (adjust if ports collide on shared cluster)
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
DCGM_PORT=9400
NODE_EXPORTER_PORT=9100
VLLM_PORT=8000

# Grafana credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Remote SSH target for tunnel & client port checks (e.g. user@gpu-node01)
GPU_SSH_TARGET=user@tensor-node01
SSH_PORT=22

# Local ports on your laptop when using SSH tunnel
LOCAL_GRAFANA_PORT=3000
LOCAL_PROMETHEUS_PORT=9090
